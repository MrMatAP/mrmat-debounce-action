{
    "name": "mrmat-debounce-action",
    "description": "A GitHub Action to avoid builds on push when there is a corresponding PR",
    "version": "0.0.0",
    "author": "MrMat",
    "license": "MIT",
    "type": "module",
    "private": true,
    "homepage": "https://github.com/MrMatAP/mrmat-debounce-action",
    "repository": {
        "type": "git",
        "url": "https://github.com//MrMatAP/mrmat-debounce-action.git"
    },
    "bugs": {
        "url": "https://github.com//MrMatAP/mrmat-debounce-action/issues"
    },
    "keywords": [
        "actions"
    ],
    "exports": {
        ".": "./dist/index.js"
    },
    "engines": {
        "node": "^24.0.0"
    },
    "scripts": {
        "bundle": "npm run format:write && npm run package",
        "format:write": "npx prettier --write .",
        "format:check": "npx prettier --check .",
        "ci-lint": "npx eslint .",
        "lint": "npx eslint .",
        "package": "npx rollup --config rollup.config.js --configPlugin @rollup/plugin-typescript",
        "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
        "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest"
    },
    "dependencies": {
        "@actions/core": "^3.0.0",
        "@actions/github": "^9.0.0",
        "@octokit/request-error": "^7.1.0",
        "@octokit/types": "^16.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@github/local-action": "^7.0.1",
        "@jest/globals": "^30.4.1",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.6.2",
        "eslint": "^10.3.0",
        "jest": "^30.4.2",
        "jest-junit": "^17.0.0",
        "jiti": "^2.7.0",
        "prettier": "^3.8.3",
        "prettier-eslint": "^16.4.2",
        "rollup": "^4.60.3",
        "ts-jest": "^29.4.9",
        "ts-jest-resolver": "^2.0.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.2",
        "globals": "^17.6.0"
    }
}
